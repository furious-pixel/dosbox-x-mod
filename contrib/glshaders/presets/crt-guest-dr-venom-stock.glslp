# MW2 / progressive-shell friendly variant of crt-guest-dr-venom-stock.
#
# Upstream stock forces absolute height 240 (240p CRT simulation) which
# destroys 640x480 shell UI (half the lines discarded). This preset keeps
# full source resolution and matches the base guest chain (afterglow + avg-lum).
# Interlace is left off via parameters (progressive content).

shaders = 11

shader0 = ../crt/shaders/guest/lut/lut.glsl
filter_linear0 = false
scale_type0 = source
scale0 = 1.0

textures = "SamplerLUT1;SamplerLUT2;SamplerLUT3"
SamplerLUT1 = ../crt/shaders/guest/lut/sony_trinitron1.png
SamplerLUT1_linear = true
SamplerLUT2 = ../crt/shaders/guest/lut/sony_trinitron2.png
SamplerLUT2_linear = true
SamplerLUT3 = ../crt/shaders/guest/lut/other1.png
SamplerLUT3_linear = true

shader1 = ../crt/shaders/guest/color-profiles.glsl
filter_linear1 = false
scale_type1 = source
scale1 = 1.0

shader2 = ../crt/shaders/guest/d65-d50.glsl
filter_linear2 = false
scale_type2 = source
scale2 = 1.0

shader3 = ../crt/shaders/guest/afterglow.glsl
filter_linear3 = false
scale_type3 = source
scale3 = 1.0

shader4 = ../crt/shaders/guest/avg-lum0.glsl
filter_linear4 = false
scale_type4 = source
scale4 = 1.0

shader5 = ../crt/shaders/guest/avg-lum.glsl
filter_linear5 = false
scale_type5 = source
scale5 = 1.0
mipmap_input5 = true

shader6 = ../crt/shaders/guest/linearize.glsl
filter_linear6 = false
scale_type6 = source
scale6 = 1.0
float_framebuffer6 = true

shader7 = ../crt/shaders/guest/blur_horiz.glsl
filter_linear7 = false
scale_type7 = source
scale7 = 1.0
float_framebuffer7 = true

shader8 = ../crt/shaders/guest/blur_vert.glsl
filter_linear8 = false
scale_type8 = source
scale8 = 1.0
float_framebuffer8 = true

shader9 = ../crt/shaders/guest/linearize_scanlines.glsl
filter_linear9 = true
scale_type9 = source
scale9 = 1.0
float_framebuffer9 = true

shader10 = ../crt/shaders/guest/crt-guest-dr-venom.glsl
filter_linear10 = true
scale_type10 = viewport
scale_x10 = 1.0
scale_y10 = 1.0

parameters = "interm;warpX;warpY"
interm = "0.000000"
warpX = "0.000000"
warpY = "0.000000"
